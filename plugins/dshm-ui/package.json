{
  "name": "dshm-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "description": "dshm 壳专属移动 UI: UA 识别(仅 DSHM 壳激活), 移动设置面板 + 目录选择器 + 界面适配 CSS",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mobile",
    "ui",
    "plugin"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh.plugin.json": "./dsh.plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "index.d.ts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "SKILL.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
