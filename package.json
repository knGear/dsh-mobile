{
  "name": "dsh-mobile-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "plugins/dsh-mobile-ui/index.js",
  "types": "plugins/dsh-mobile-ui/index.d.ts",
  "description": "dshm 壳专属移动 UI: UA 识别(仅 DSHM 壳激活), 移动设置面板 + 目录选择器 + 界面适配 CSS",
  "keywords": ["dsh", "dsh-plugin", "mobile", "ui", "plugin"],
  "exports": {
    ".": {
      "types": "./plugins/dsh-mobile-ui/index.d.ts",
      "default": "./plugins/dsh-mobile-ui/index.js"
    },
    "./client": "./plugins/dsh-mobile-ui/client.js",
    "./cordis.patch.yml": "./plugins/dsh-mobile-ui/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["plugins/dsh-mobile-ui"],
  "scripts": {
    "check": "node --check plugins/dsh-mobile-ui/index.js && node --check plugins/dsh-mobile-ui/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugins/dsh-mobile-ui/cordis.patch.yml"
    },
    "client": {
      "inject": ["slots"],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
